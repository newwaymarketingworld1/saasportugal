# Copie este arquivo para .env.local e preencha os valores.
# NUNCA faça commit do .env.local.

# Supabase > Project Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Supabase > Project Settings > API > anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase > Project Settings > API > service_role key
# SEGREDO: só é usada no servidor (rota /api/briefing). Nunca exponha no front.
SUPABASE_SERVICE_ROLE_KEY=

# Texto aleatório longo, usado para gerar o hash dos IPs (rate limit).
# Gere com: openssl rand -hex 32
IP_HASH_SALT=

# Opcional: URL pública do site (usada na checagem de origem do formulário).
# Ex.: https://briefing.newwaymarketingworld.com.br
NEXT_PUBLIC_SITE_URL=
